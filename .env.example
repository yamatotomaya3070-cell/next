# Supabase プロジェクト設定（https://supabase.com/dashboard → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Gemini API（未設定の場合はモックAIで動作します）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# 動画理解（参考動画の解析）に使うモデル。動画入力対応が必要。既定 gemini-2.5-flash。
# GEMINI_VIDEO_MODEL=gemini-2.5-flash

# 参考動画のクラウド自動解析 Cron（/api/cron/process-ingests）の保護トークン。
# 本番では必ず設定する（Vercel が Authorization: Bearer で自動付与）。任意のランダム文字列。
# 未設定でもCronは動くが、誰でも叩けるため本番では設定推奨。
CRON_SECRET=

# 管理者クライアント専用（scripts/video/worker.ts, scripts/video/inspect-worker.ts,
# src/lib/supabase/admin.ts 経由の "use server" アクション）。
# Supabase Dashboard → Project Settings → API → service_role key。
# サーバー/ワーカーからのみ使用し、クライアント（ブラウザ）へは絶対に渡さないこと。
# NEXT_PUBLIC_ プレフィックスを付けないこと（付けるとブラウザに露出する）。
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# 動画生成ワーカー（Docker常駐）専用。ローカル(Windows)開発では未設定でOK。
# ============================================================================
# --- TTSバックエンド選択 ---------------------------------------------------
# 優先順: TTS_BACKEND > (GEMINI_TTS_MODEL|GEMINI_TTS=1)=gemini > VOICEVOX_URL=voicevox > sapi
# Gemini TTS は日本語ネイティブ品質で、既存の GEMINI_API_KEY をそのまま流用する（推奨）。
# 明示指定したい場合のみ TTS_BACKEND を設定する:
#   TTS_BACKEND=gemini
# Gemini TTSモデル（設定するだけでGemini経路が有効になる）。新preview版に上書き可:
#   GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# 話者ごとのプリセット音声（未設定なら voiceProfile順に Kore/Puck/Charon/Aoede を割当）:
#   GEMINI_TTS_VOICE_speaker_a=Kore       # character_explainer のアオ
#   GEMINI_TTS_VOICE_speaker_b=Puck       # ミドリ
#   GEMINI_TTS_VOICE_narrator=Charon      # business_explainer のナレーター
#   GEMINI_TTS_VOICE_interviewer=Kore     # interview_edit の聞き手
#   GEMINI_TTS_VOICE_interviewee=Puck     # 話し手
# 利用可能な音声名の例: Zephyr, Puck, Charon, Kore, Fenrir, Leda, Orus, Aoede ほか計30種

# --- 実写Bロール（ストック動画） -------------------------------------------
# 設定すると、背景を静止画スライドから実写ストック動画に差し替えられる（--broll 有効時）。
# pexels.com/api で無料取得。未設定なら自動で静止画背景にフォールバックする。
# 商用可・帰属不要のライセンスだが、API利用時はPexels/撮影者のクレジット表示が求められる
# （素材ZIPへ credits を同梱する設計）。
# PEXELS_API_KEY=

# VOICEVOX エンジンのURL。設定するとTTSがWindows SAPIからVOICEVOXに切り替わる。
# docker-compose.yml が自動で http://voicevox:50021 を注入するため、
# Docker運用では通常このファイルに書く必要はない。
# VOICEVOX_URL=http://voicevox:50021

# 話者を変えたい場合のみ設定（コード改修不要）。既定は 3=ずんだもん。
#   VOICEVOX_SPEAKER=3                 # 全プロファイル共通の既定
#   VOICEVOX_SPEAKER_speaker_a=13      # プロファイル個別指定（例: character_explainer のアオ）
#   VOICEVOX_SPEAKER_speaker_b=2       # ミドリ
#   VOICEVOX_SPEAKER_narrator=8        # business_explainer のナレーター
#   VOICEVOX_SPEAKER_interviewer=14    # interview_edit の聞き手
#   VOICEVOX_SPEAKER_interviewee=11    # interview_edit の話し手

# 字幕/焼き込みテキスト用フォント。Docker側で Noto CJK に自動設定される。
# Windows開発機では未設定 → 既定の meiryo / "Meiryo" が使われる。
# VIDEO_FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# VIDEO_FONT_NAME=Noto Sans CJK JP

# --watch 常駐時のポーリング間隔（ミリ秒）。既定 15000。
# WORKER_POLL_MS=15000
