# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# 動画生成パイプラインのローカル作業領域（生成MP4/WAV/一時ファイル。数十MB〜のため追跡しない）
/scripts/output/

# 生成物（動画・音声・素材パッケージ・キャラ画像などの大容量出力）
poc/**/out/

# 就労者へ配る素材パッケージ（数十MB。Git では管理せず、配布物として別途渡す）
/テスト用_動画編集パッケージ/
/テスト用_動画編集パッケージ.zip

# supabase CLI の一時ファイル
/supabase/.temp/
