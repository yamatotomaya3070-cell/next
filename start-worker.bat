@echo off
REM つなぐワークス YouTube動画生成ワーカー（常駐）
REM このファイルをダブルクリックすると、テーマ入力で登録された動画生成ジョブを自動で処理し続けます。
REM 閉じるとワーカーが止まります。生成中はこのウィンドウを開いたままにしてください。
title 絆ワーカー（YouTube動画生成）
cd /d "%~dp0"
echo ================================================
echo  つなぐワークス ワーカー起動（YouTube動画生成）
echo  このウィンドウは開いたままにしてください。
echo ================================================
npm run scene:worker -- --watch
echo.
echo ワーカーが停止しました。何かキーを押すと閉じます。
pause >nul
