@echo off
REM つなぐワークス ワーカー（常駐）
REM このファイルをダブルクリックすると、次の2つのワーカーが別々のウィンドウで動き続けます。
REM   1. YouTube動画生成ワーカー … テーマ入力で登録された動画生成ジョブを処理する
REM   2. 提出動画の検品ワーカー … 利用者が提出した動画を完成見本と自動で照合し、
REM                               明らかな間違いがあれば自動で差し戻す
REM どちらのウィンドウも閉じるとそのワーカーが止まります。開いたままにしてください。
title 絆ワーカー（起動）
cd /d "%~dp0"
echo ================================================
echo  つなぐワークス ワーカー起動
echo  2つのウィンドウが開きます。どちらも閉じないでください。
echo ================================================
start "絆ワーカー（提出動画の検品）" cmd /k "cd /d "%~dp0" && npm run video:inspect-worker -- --watch"
title 絆ワーカー（YouTube動画生成）
npm run scene:worker -- --watch
echo.
echo ワーカーが停止しました。何かキーを押すと閉じます。
pause >nul
